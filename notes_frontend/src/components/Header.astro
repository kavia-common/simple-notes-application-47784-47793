---
/**
 * Header component: title, search, and create button
 * Props:
 *  - onCreate: id of button to attach click listener
 *  - onSearch: id of input to attach input listener
 */
const { title = 'Notes', ctaId = 'new-note-btn', searchId = 'search-notes' } = Astro.props as {
  title?: string;
  ctaId?: string;
  searchId?: string;
};
---
<header class="app-header">
  <div class="brand">
    <div class="logo">🗒️</div>
    <h1>{title}</h1>
  </div>
  <div class="actions">
    <div class="search">
      <input id={searchId} type="search" placeholder="Search notes..." aria-label="Search notes" />
    </div>
    <button id={ctaId} class="btn btn-primary">New Note</button>
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(180deg, rgba(37,99,235,0.06), rgba(249,250,251,1));
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 16px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .logo { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 10px; background: #2563EB; color: white; }
  h1 { margin: 0; font-size: 20px; color: #111827; }
  :global(body.dark-theme) h1 { color: #f9fafb; }
  .actions { display: flex; gap: 10px; align-items: center; }
  .search input {
    width: min(60vw, 340px);
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,0.1);
    outline: none;
    background: #ffffff;
    color: #111827;
    transition: box-shadow .2s, border-color .2s;
  }
  .search input:focus {
    border-color: #2563EB;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
  }
  .btn {
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    cursor: pointer;
    transition: transform .05s ease, box-shadow .2s ease, background .2s ease;
  }
  .btn-primary {
    background: #2563EB;
    color: white;
    box-shadow: 0 6px 14px rgba(37,99,235,0.25);
  }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 18px rgba(37,99,235,0.35); }
  .btn-primary:active { transform: translateY(0); }
  @media (max-width: 640px) {
    .app-header { grid-template-columns: 1fr; }
    .actions { justify-content: space-between; }
    .search input { width: 100%; }
  }
</style>
